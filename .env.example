# GuardSync Environment Configuration
# Copy this file to .env and fill in the required values

# Node Environment
# Use 'production' for production, 'development' for local development
NODE_ENV=development

# API Server Port
PORT=4000

# JWT Secret for authentication tokens
# REQUIRED in production - Generate with:
#   openssl rand -hex 64
# OR
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# 
# IMPORTANT: 
# - Use a different secret for each environment (dev, staging, production)
# - NEVER commit the actual production secret to version control
# - Store production secrets securely (e.g., AWS Secrets Manager, Azure Key Vault)
JWT_SECRET=<generate-with-openssl-rand-hex-64>

# PII Encryption Key (AES-256-GCM)
# REQUIRED: 64 hexadecimal characters (32 bytes)
# Generate a secure key with:
#   openssl rand -hex 32
# OR
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 
# IMPORTANT: 
# - Use a different key for each environment (dev, staging, production)
# - NEVER commit the actual production key to version control
# - Store production keys securely (e.g., AWS Secrets Manager, Azure Key Vault)
# - If you lose this key, encrypted data CANNOT be recovered
# - Aadhar numbers are protected under India's Aadhaar Act - encryption is a legal requirement
ENCRYPTION_KEY=<generate-64-hex-chars>

# Database Path (SQLite)
# Relative to server directory
DB_PATH=./data/gw.db

# API Base URL (for frontend apps)
VITE_API_URL=http://localhost:4000

# Demo data
# true  = start with sample sites, guards and staff (demos, local development)
# false = start empty with one admin account (real customers)
SEED_DEMO=false

# First admin account (used when the database is empty).
# If ADMIN_PASSWORD is not set, one is generated and printed once in the server log.
# ADMIN_EMAIL=admin@yourcompany.com
# ADMIN_PASSWORD=

# docker-compose reads JWT_SECRET and ENCRYPTION_KEY from a file named .env next to
# docker-compose.yml. Copy this file to .env and fill them in. Never commit .env.
